// # oobound Bounds Calculator and Command Generator
//
// Logline: Calculates systemd and prlimit invocations and audits resource limits.
//
// Setup: Generates native systemd-run and prlimit command lines.
//
// Beats:
//   1. Build systemd-run transient scope command line.
//   2. Build prlimit bounded command line.
//   3. Generate cgroup v2 controller configuration block.
//   4. Audit boundary values against negative-trust security baselines.

import "core/bound_preset.oo";

pub fn generate_systemd_cmd(b: BoundLimits, cmd: String) -> String {
    let mut out: String = "systemd-run --user --scope";
    out = out + " -p MemoryMax=" + to_string(b.mem_mb) + "M";
    out = out + " -p CPUQuota=" + to_string(b.cpu_pct) + "%";
    out = out + " -p LimitNOFILE=" + to_string(b.max_fds);
    out = out + " -p TasksMax=" + to_string(b.max_procs);
    if b.sandboxed {
        out = out + " -p ProtectSystem=strict -p ProtectHome=read-only -p PrivateTmp=yes -p NoNewPrivileges=yes";
    }
    if chars_len(cmd) > 0 {
        out = out + " -- " + cmd;
    }
    return out;
}

pub fn generate_prlimit_cmd(b: BoundLimits, cmd: String) -> String {
    let as_bytes: Int = b.mem_mb * 1048576;
    let mut out: String = "prlimit";
    out = out + " --as=" + to_string(as_bytes);
    out = out + " --cpu=" + to_string(b.timeout_sec);
    out = out + " --nofile=" + to_string(b.max_fds);
    out = out + " --nproc=" + to_string(b.max_procs);
    if chars_len(cmd) > 0 {
        out = out + " -- " + cmd;
    }
    return out;
}

pub fn generate_cgroup_spec(b: BoundLimits) -> String {
    let cpu_quota_us: Int = b.cpu_pct * 1000;
    return "memory.max = " + to_string(b.mem_mb) + "M\n"
        + "cpu.max = " + to_string(cpu_quota_us) + " 100000\n"
        + "pids.max = " + to_string(b.max_procs) + "\n";
}

pub fn audit_bounds(b: BoundLimits) -> String {
    let mut issues: String = "";
    let mut issue_count: Int = 0;

    if b.mem_mb <= 0 {
        issues = issues + "- Memory limit must be greater than 0 MB\n";
        issue_count = issue_count + 1;
    } else if b.mem_mb > 32768 {
        issues = issues + "- Memory ceiling exceeds 32GB safety boundary\n";
        issue_count = issue_count + 1;
    }

    if b.cpu_pct <= 0 {
        issues = issues + "- CPU quota percentage must be greater than 0%\n";
        issue_count = issue_count + 1;
    } else if b.cpu_pct > 1600 {
        issues = issues + "- CPU quota exceeds 1600% (16 cores)\n";
        issue_count = issue_count + 1;
    }

    if b.max_fds < 16 {
        issues = issues + "- File descriptor count under minimum working floor (16)\n";
        issue_count = issue_count + 1;
    }

    if b.max_procs < 4 {
        issues = issues + "- Process limit under minimal thread requirement (4)\n";
        issue_count = issue_count + 1;
    }

    if b.timeout_sec <= 0 {
        issues = issues + "- Execution timeout must be greater than 0 seconds\n";
        issue_count = issue_count + 1;
    } else if b.timeout_sec > 86400 {
        issues = issues + "- Execution timeout exceeds 24-hour ceiling\n";
        issue_count = issue_count + 1;
    }

    if issue_count == 0 {
        return "PASS: All resource boundaries satisfy negative-trust security baselines (score: 100/100)";
    }
    return "FAIL (" + to_string(issue_count) + " issues found):\n" + issues;
}

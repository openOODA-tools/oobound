// # oobound Root Package Anchor
//
// Logline: Unified subsystem anchor for sovereign process boundary containment.
//
// Setup: Bridges core calculations, renderers, and IPC communication layers.
//
// Beats:
//   1. Verify core limits calculation subsystem.
//   2. Verify terminal rendering and styling subsystem.
//   3. Verify IPC options and MCP communication subsystem.
//   4. Expose package readiness predicate.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_oobound_package() -> Bool {
    if !verify_core_subsystem() { return false; }
    if !verify_render_subsystem() { return false; }
    if !verify_ipc_subsystem() { return false; }
    return true;
}
